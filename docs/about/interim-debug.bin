1a1:{"name":"SiteMarkdownContent","key":null,"env":"Server","owner":"$2b","stack":[["rendere","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__1n3w8thybi_rt._.js",1274,263,1272,1,false],["renderLocalizedMarkdown","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__1n3w8thybi_rt._.js",1288,24,1284,1,false],["","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__1n3w8thybi_rt._.js",1341,245,1340,52,false],["Array.forEach","",0,0,0,0,false],["","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__1n3w8thybi_rt._.js",1340,44,1301,32,false],["Array.map","",0,0,0,0,false],["renderCmsMarkdown","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__1n3w8thybi_rt._.js",1301,28,1295,1,false],["CmsCatchAllPage","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__0s8yetrxx9fn5._.js",216,221,195,1,false]],"props":{"content":"Aktuelle Entwicklungen und die Selbstverpflichtungen der Industrie fördern langfristig die Nachfrage nach Kunststoff-Rezyklaten. Damit diese in Anwendungen genutzt werden können, helfen digitale Lösungen durch die Schaffung einer effizienten Struktur bei der Identifikation passender Recyclingkunststoffe. Wir möchten einen klaren Informationsmehrwert durch unsere digitale Plattform liefern, auf der sich Rohstoffe voneinander abgrenzen lassen und auf der sich die Wertschöpfungskette miteinander vernetzen kann.","remarkPlugins":"$undefined"}}
1a2:{"time":196.8245830014348}
1a3:{"name":"Markdown","key":null,"env":"Server","owner":"$1a1","stack":[["SiteMarkdownContent","/app/apps/web/.next/dev/server/chunks/ssr/[root-of-the-server]__1n3w8thybi_rt._.js",248,263,247,1,false]],"props":{"components":"$15a:props:components","urlTransform":"$15c","remarkPlugins":"$undefined","rehypePlugins":[["$15d",{"pageHeadingLine":null}],["$15e",{"eagerFirst":false}],["$15f",{"content":"Aktuelle Entwicklungen und die Selbstverpflichtungen der Industrie fördern langfristig die Nachfrage nach Kunststoff-Rezyklaten. Damit diese in Anwendungen genutzt werden können, helfen digitale Lösungen durch die Schaffung einer effizienten Struktur bei der Identifikation passender Recyclingkunststoffe. Wir möchten einen klaren Informationsmehrwert durch unsere digitale Plattform liefern, auf der sich Rohstoffe voneinander abgrenzen lassen und auf der sich die Wertschöpfungskette miteinander vernetzen kann.","fallback":"$undefined"}],"$160","$161"],"children":"Aktuelle Entwicklungen und die Selbstverpflichtungen der Industrie fördern langfristig die Nachfrage nach Kunststoff-Rezyklaten. Damit diese in Anwendungen genutzt werden können, helfen digitale Lösungen durch die Schaffung einer effizienten Struktur bei der Identifikation passender Recyclingkunststoffe. Wir möchten einen klaren Informationsmehrwert durch unsere digitale Plattform liefern, auf der sich Rohstoffe voneinander abgrenzen lassen und auf der sich die Wertschöpfungskette miteinander vernetzen kann."}}
